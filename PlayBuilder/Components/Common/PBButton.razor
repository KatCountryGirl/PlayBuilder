@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="pb-button @VariantClass @SizeClass"
       href="@Href"
       aria-disabled="@Disabled">
        @ChildContent
    </a>
}
else
{
    <button class="pb-button @VariantClass @SizeClass"
            type="@Type"
            disabled="@Disabled"
            @onclick="OnClick">
        @ChildContent
    </button>
}

@code {
    [Parameter] public string Variant { get; set; } = "Primary";
    [Parameter] public string Size { get; set; } = "Normal";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string VariantClass => $"pb-button--{Variant.ToLowerInvariant()}";
    private string SizeClass => $"pb-button--{Size.ToLowerInvariant()}";
}

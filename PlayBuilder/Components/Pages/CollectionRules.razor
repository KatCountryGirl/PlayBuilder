@page "/collection-rules"
@inject IScanReportService ScanReportService
@inject ICollectionRuleService CollectionRuleService
@inject ICollectionService Collections
@inject ISettingsService SettingsService
@inject IAtlasProfileService AtlasProfiles
@inject NavigationManager Navigation

<PageTitle>Collection Builder · PlayBuilder</PageTitle>

<main class="rules-page">
    @if (_isLoading)
    {
        <section class="state-card">Loading your latest archive analysis…</section>
    }
    else if (_scan is null)
    {
        <section class="state-card">
            <div class="state-icon" aria-hidden="true">🔍</div>
            <h1>Scan your collection first.</h1>
            <p>PlayBuilder needs a completed archive analysis before it can preview 1G1R choices.</p>
            <PBButton Href="dashboard">Go to Dashboard</PBButton>
        </section>
    }
    else
    {
        <section class="rules-hero">
            <div>
                <p class="eyebrow">COLLECTION BUILDER</p>
                <h1>Build a collection made for the way you play.</h1>
                <p>Start with 1G1R, favorites, top games, genres, series, or a completely custom collection. Your archive remains untouched.</p>
            </div>
            <div class="hero-icon" aria-hidden="true">🎮</div>
        </section>

        <section class="collection-type-card">
            <p class="eyebrow">COLLECTION TYPE</p>
            <div class="collection-type-grid">
                @foreach (var type in CollectionTypes)
                {
                    <button class="collection-type-option active-@(_collectionType == type.Id)"
                            type="button"
                            @onclick="() => SetCollectionTypeAsync(type.Id)">
                        <span aria-hidden="true">@type.Icon</span>
                        <strong>@type.Title</strong>
                        <small>@type.Description</small>
                        @if (!type.Available)
                        {
                            <b>Coming next</b>
                        }
                    </button>
                }
            </div>
        </section>

        <section class="protection-card">
            <span aria-hidden="true">🛡️</span>
            <div>
                <strong>Recommendation mode only</strong>
                <p>PlayBuilder is only previewing decisions. It will not copy, move, rename, or delete anything.</p>
            </div>
        </section>

        <section class="collection-type-card system-selection-card">
            <p class="eyebrow">CHOOSE SYSTEMS</p>
            <div class="review-controls" aria-label="Collection system selection">
                <label class="search-box">
                    Search systems
                <input @bind="_systemSelection.SearchText" @bind:event="oninput" placeholder="System name or alias" aria-label="Search systems" />
                </label>
                <span class="preview-count">@_systemSelection.SelectedCount.ToString("N0") of @_systemSelection.Systems.Count.ToString("N0") systems selected · @FilteredCatalogSystems.Count.ToString("N0") visible</span>
            </div>
            <p class="selected-system-summary">@SelectedSystemsSummary</p>
            <div class="selection-actions">
                <button type="button" @onclick="SelectAllSystemsAsync">Select All</button>
                <button type="button" @onclick="SelectNoSystemsAsync">Select None</button>
                <button type="button" disabled="@(FilteredCatalogSystems.Count == 0)" @onclick="SelectMatchingSystemsAsync">Select Matching</button>
            </div>
            <div class="system-checkbox-grid">
                @foreach (var system in FilteredCatalogSystems)
                {
                    <label class="compact-check system-card" @key="system.SystemKey">
                        <input type="checkbox"
                               checked="@_systemSelection.IsSelected(system.SystemKey)"
                               @onchange="args => ToggleSystemAsync(system.SystemKey, args)" />
                        <span class="system-media" aria-hidden="true">@SystemMediaIcon(system)</span>
                        <span>@system.Name <small>@SystemIdentity.ResolveMediaType(system.Name, system.SystemKey)</small></span>
                        <small>@system.ReleaseCount.ToString("N0")</small>
                    </label>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_systemMessage))
            {
                <p class="save-message">@_systemMessage</p>
            }
        </section>

        @if (_collectionType == "1g1r")
        {
        <section class="mode-card">
            <p class="eyebrow">COLLECTION MODE</p>
            <div class="mode-grid">
                <label class="mode-option active-@(_options.Mode == OneGameOneRomMode.AllGames)">
                    <input type="radio" name="collection-mode" value="@OneGameOneRomMode.AllGames"
                           checked="@(_options.Mode == OneGameOneRomMode.AllGames)"
                           @onchange="() => SetMode(OneGameOneRomMode.AllGames)" />
                    <span class="mode-icon" aria-hidden="true">🌎</span>
                    <span><strong>1G1R — All Games</strong><small>Keep one preferred playable release for every unique game in the selected systems.</small></span>
                </label>
                <label class="mode-option active-@(_options.Mode == OneGameOneRomMode.EnglishOnly)">
                    <input type="radio" name="collection-mode" value="@OneGameOneRomMode.EnglishOnly"
                           checked="@(_options.Mode == OneGameOneRomMode.EnglishOnly)"
                           @onchange="() => SetMode(OneGameOneRomMode.EnglishOnly)" />
                    <span class="mode-icon" aria-hidden="true">🇺🇸</span>
                    <span><strong>1G1R — English Only</strong><small>Keep one preferred English-capable release for every unique game in the selected systems.</small></span>
                </label>
            </div>
        </section>

        <details class="advanced-options">
            <summary>
                <span>Advanced Options</span>
                <small>Profiles and saved expert preferences</small>
            </summary>
        <section class="profile-card">
            <div>
                <p class="eyebrow">ATLAS PROFILE</p>
                <h2>@(_activeProfile?.Name ?? "Profile")</h2>
                <p>Named preference profiles save Atlas rule switches and priority orders for this collection mode.</p>
            </div>
            <div class="profile-controls">
                <label>
                    Active profile
                    <select value="@_activeProfileId" @onchange="ChangeActiveProfileAsync">
                        @foreach (var profile in _profiles.Profiles)
                        {
                            <option value="@profile.Id">@profile.Name</option>
                        }
                    </select>
                </label>
                <label>
                    Profile name
                    <input value="@_profileName" @oninput="args => _profileName = args.Value?.ToString() ?? string.Empty" />
                </label>
                <div class="profile-actions">
                    <button type="button" @onclick="CreateProfileAsync">New</button>
                    <button type="button" disabled="@(_activeProfile is null)" @onclick="DuplicateProfileAsync">Duplicate</button>
                    <button type="button" disabled="@(_activeProfile is null)" @onclick="SaveActiveProfileAsync">Save</button>
                    <button type="button" disabled="@(_activeProfile is null)" @onclick="RenameProfileAsync">Rename</button>
                    <button type="button" disabled="@(_profiles.Profiles.Count <= 1 || _activeProfile is null)" @onclick="DeleteActiveProfileAsync">Delete</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_profileMessage))
                {
                    <p class="profile-message">@_profileMessage</p>
                }
            </div>
        </section>
        </details>

        <section class="rule-layout">
            <aside class="rules-panel">
                <section class="priority-section">
                    <p class="eyebrow">LANGUAGE PREFERENCE</p>
                    <h2>Which language wins?</h2>
                    <p class="panel-copy">Move your preferred language to the top. In All Games mode, non-preferred languages are still kept when they are the only version of a unique game.</p>

                    <ol class="priority-list compact-list">
                        @foreach (var language in _options.LanguagePriority.ToArray())
                        {
                            var currentLanguage = language;
                            var index = _options.LanguagePriority.IndexOf(currentLanguage);
                            <li @key="currentLanguage">
                                <span class="drag-handle" aria-hidden="true">☰</span>
                                <span class="priority-number">@(index + 1)</span>
                                <strong>@currentLanguage</strong>
                                <div class="priority-actions">
                                    <button type="button" title="Move @currentLanguage up" disabled="@(index <= 0)" @onclick="() => MoveLanguage(currentLanguage, -1)">↑</button>
                                    <button type="button" title="Move @currentLanguage down" disabled="@(index < 0 || index >= _options.LanguagePriority.Count - 1)" @onclick="() => MoveLanguage(currentLanguage, 1)">↓</button>
                                </div>
                            </li>
                        }
                    </ol>
                </section>

                <section class="priority-section">
                    <p class="eyebrow">REGION PREFERENCE</p>
                    <h2>Which region wins next?</h2>
                    <p class="panel-copy">Region priority breaks ties after language preference.</p>

                    <ol class="priority-list compact-list">
                        @foreach (var region in _options.RegionPriority.ToArray())
                        {
                            var currentRegion = region;
                            var index = _options.RegionPriority.IndexOf(currentRegion);
                            <li @key="currentRegion">
                                <span class="drag-handle" aria-hidden="true">☰</span>
                                <span class="priority-number">@(index + 1)</span>
                                <strong>@currentRegion</strong>
                                <div class="priority-actions">
                                    <button type="button" title="Move @currentRegion up" disabled="@(index <= 0)" @onclick="() => MoveRegion(currentRegion, -1)">↑</button>
                                    <button type="button" title="Move @currentRegion down" disabled="@(index < 0 || index >= _options.RegionPriority.Count - 1)" @onclick="() => MoveRegion(currentRegion, 1)">↓</button>
                                </div>
                            </li>
                        }
                    </ol>
                </section>

                <div class="preset-actions">
                    <button type="button" class="preset-button" @onclick="UseEnglishPreset">English first</button>
                    <button type="button" class="preset-button" @onclick="UseJapanesePreset">Japanese first</button>
                    <button type="button" class="preset-button" @onclick="UseEuropeanPreset">Europe first</button>
                </div>

                <details class="advanced-options rules-advanced">
                    <summary>
                        <span>Advanced Options</span>
                        <small>Rule switches and diagnostics</small>
                    </summary>
                <div class="toggle-list">
                    <label>
                        <input type="checkbox" checked="@IsRuleEnabled(DumpQualityRuleName)" @onchange="args => SetRuleEnabled(DumpQualityRuleName, args)" />
                        <span><strong>Use dump-quality rule</strong><small>Verified dumps beat neutral dumps, and known bad dumps lose when better evidence exists.</small></span>
                    </label>
                    <label>
                        <input type="checkbox" checked="@IsRuleEnabled(LanguageRuleName)" @onchange="args => SetRuleEnabled(LanguageRuleName, args)" />
                        <span><strong>Use language priority rule</strong><small>Language order decides before region order.</small></span>
                    </label>
                    <label>
                        <input type="checkbox" checked="@IsRuleEnabled(RegionRuleName)" @onchange="args => SetRuleEnabled(RegionRuleName, args)" />
                        <span><strong>Use region priority rule</strong><small>Region order breaks ties after language preference.</small></span>
                    </label>
                    <label>
                        <input type="checkbox" checked="@_options.AvoidSpecialReleases" @onchange="SetReleaseRule" />
                        <span><strong>Avoid beta, demo, hack, and prototype copies</strong><small>Standard retail releases win when available.</small></span>
                    </label>
                    <label>
                        <input type="checkbox" checked="@_options.PreferNewestRevision" @onchange="SetRevisionRule" />
                        <span><strong>Prefer newer revisions</strong><small>Rev 2 beats Rev 1 when language and region are equal.</small></span>
                    </label>
                    <label>
                        <input type="checkbox" checked="@_options.PreferNewestVersion" @onchange="SetVersionRule" />
                        <span><strong>Prefer newer versions</strong><small>Version 1.1 beats Version 1.0 when earlier rules tie.</small></span>
                    </label>
                </div>

                <section class="diagnostics-strip" aria-label="1G1R diagnostics">
                    <article><span>Total games loaded</span><strong>@_preview.Diagnostics.TotalRomsLoaded.ToString("N0")</strong></article>
                    <article><span>Valid filenames</span><strong>@_preview.Diagnostics.ValidFilenames.ToString("N0")</strong></article>
                    <article><span>Normalized titles</span><strong>@_preview.Diagnostics.NormalizedTitles.ToString("N0")</strong></article>
                    <article><span>Unique title groups</span><strong>@_preview.Diagnostics.UniqueTitleGroups.ToString("N0")</strong></article>
                    <article><span>Single-game groups</span><strong>@_preview.Diagnostics.SingleRomGroups.ToString("N0")</strong></article>
                    <article><span>Multi-game groups</span><strong>@_preview.Diagnostics.MultiRomGroups.ToString("N0")</strong></article>
                    <article><span>Rejected before Atlas</span><strong>@_preview.Diagnostics.GroupsRejectedBeforeAtlas.ToString("N0")</strong></article>
                    <article><span>English-only excluded</span><strong>@_preview.Diagnostics.GroupsExcludedByEnglishOnlyMode.ToString("N0")</strong></article>
                    <article><span>Final recommendations</span><strong>@_preview.Diagnostics.FinalRecommendations.ToString("N0")</strong></article>
                </section>
                </details>
            </aside>

            <section class="preview-panel">
                <div class="preview-heading">
                    <div>
                        <p class="eyebrow">LIVE RECOMMENDATIONS · @_preview.EngineName</p>
                        <h2>What PlayBuilder would keep</h2>
                    </div>
                    <span class="preview-count">@_review.SelectedCount.ToString("N0") selected · @_review.ExcludedCount.ToString("N0") excluded</span>
                </div>

                <div class="summary-grid">
                    <button type="button" class="@SummaryFilterClass(CollectionReviewSummaryFilter.Confident)" @onclick="() => ToggleSummaryFilter(CollectionReviewSummaryFilter.Confident)"><span>Confident choices</span><strong>@_preview.ConfidentSelections.ToString("N0")</strong><small>Language and region identified</small></button>
                    <button type="button" class="@SummaryFilterClass(CollectionReviewSummaryFilter.NeedsReview)" @onclick="() => ToggleSummaryFilter(CollectionReviewSummaryFilter.NeedsReview)"><span>Needs review</span><strong>@_preview.FallbackSelections.ToString("N0")</strong><small>Unknown language or region</small></button>
                    <button type="button" class="@SummaryFilterClass(CollectionReviewSummaryFilter.ExtraVersions)" @onclick="() => ToggleSummaryFilter(CollectionReviewSummaryFilter.ExtraVersions)"><span>Extra versions</span><strong>@_preview.AlternativesExcluded.ToString("N0")</strong><small>Alternate game files not selected</small></button>
                    @if (_options.Mode == OneGameOneRomMode.EnglishOnly)
                    {
                        <article><span>No English release</span><strong>@_preview.GroupsExcludedByLanguage.ToString("N0")</strong><small>Excluded by English-only mode</small></article>
                    }
                </div>

                <section class="review-controls" aria-label="Recommendation filters and selection controls">
                    <label class="search-box">
                        Search
                        <input @bind="_filters.SearchText" @bind:event="oninput" placeholder="Title, filename, or system" />
                    </label>
                    <label>
                        Language
                        <select value="@_filters.Language" @onchange="args => _filters.Language = args.Value?.ToString() ?? string.Empty">
                            <option value="">All languages</option>
                            @foreach (var language in AvailableLanguages)
                            {
                                <option value="@language">@language</option>
                            }
                        </select>
                    </label>
                    <label>
                        Region
                        <select value="@_filters.Region" @onchange="args => _filters.Region = args.Value?.ToString() ?? string.Empty">
                            <option value="">All regions</option>
                            @foreach (var region in AvailableRegions)
                            {
                                <option value="@region">@region</option>
                            }
                        </select>
                    </label>
                    <label class="compact-check"><input type="checkbox" checked="@_filters.SelectedOnly" @onchange="args => _filters.SelectedOnly = args.Value is bool value && value" /> Selected only</label>
                    <label class="compact-check"><input type="checkbox" checked="@_filters.ExcludedOnly" @onchange="args => _filters.ExcludedOnly = args.Value is bool value && value" /> Excluded only</label>
                    <label class="compact-check"><input type="checkbox" checked="@_filters.NeedsReviewOnly" @onchange="args => _filters.NeedsReviewOnly = args.Value is bool value && value" /> Needs review only</label>
                </section>

                <section class="selection-actions" aria-label="Recommendation selection actions">
                    <button type="button" @onclick="SelectDisplayedRecommendations">Select All</button>
                    <button type="button" @onclick="SelectNoDisplayedRecommendations">Select None</button>
                    <button type="button" @onclick="InvertDisplayedRecommendations">Invert Selection</button>
                    <button type="button" @onclick="ResetRecommendations">Reset to Atlas Recommendations</button>
                    <button type="button" class="primary" disabled="@(_isSavingOneGameOneRom || _review.SelectedCount == 0)" @onclick="SaveOneGameOneRomAsync">@(_isSavingOneGameOneRom ? "Saving..." : "Review Build")</button>
                </section>

                @if (!string.IsNullOrWhiteSpace(_oneGameOneRomMessage))
                {
                    <p class="save-message">@_oneGameOneRomMessage</p>
                }

                @if (_preview.Selections.Count == 0)
                {
                    <div class="empty-preview">
                        <span aria-hidden="true">✨</span>
                        <h3>No 1G1R groups are available for this mode.</h3>
                        <p>Your scan did not find eligible title groups for the selected mode.</p>
                    </div>
                }
                else
                {
                    @if (ShowingAlternates)
                    {
                        <div class="alternate-list">
                            @foreach (var alternate in DisplayedAlternates.Take(80))
                            {
                                <article class="alternate-card" @key="AlternateKey(alternate)">
                                    <span>@alternate.Title</span>
                                    <strong>@alternate.AlternateFilename</strong>
                                    <small>Winner: @alternate.SelectedWinner</small>
                                    <p>@alternate.Reason</p>
                                    @if (alternate.Selection.AtlasInspection is not null)
                                    {
                                        <button type="button" class="inspect-button" @onclick="() => InspectSelection(alternate.Selection)">Inspect</button>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                    <div class="selection-list">
                        @foreach (var selection in DisplayedSelections.Take(80))
                        {
                            <details class="selection-card fallback-@selection.IsFallback.ToString().ToLowerInvariant()" @key="selection.SelectionKey">
                                <summary>
                                    <label class="selection-status real-check" @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@_review.IsSelected(selection)" @onchange="args => ToggleSelection(selection, args)" />
                                    </label>
                                    <div class="selection-main">
                                        <span class="game-title">@selection.Title</span>
                                        <strong>@selection.RecommendedVariant</strong>
                                        <small>@selection.Reason</small>
                                    </div>
                                    <div class="choice-pills">
                                        <span class="region-pill">@selection.RecommendedLanguage</span>
                                        <span class="region-pill">@selection.RecommendedRegion</span>
                                        @if (selection.AtlasInspection is not null)
                                        {
                                            <button type="button"
                                                    class="inspect-button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick:preventDefault="true"
                                                    @onclick="() => InspectSelection(selection)">
                                                Inspect
                                            </button>
                                        }
                                    </div>
                                </summary>
                                <div class="alternatives">
                                    @if (selection.DecisionReasons.Count > 0)
                                    {
                                        <p><strong>@(selection.IsFallback ? "Why this needs review:" : "Why Atlas selected this game file:")</strong></p>
                                        <ul>
                                            @foreach (var reason in selection.DecisionReasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                    }
                                    <p>Other copies that remain untouched in the original archive:</p>
                                    <ul>
                                        @foreach (var alternative in selection.Alternatives)
                                        {
                                            <li>@alternative</li>
                                        }
                                    </ul>
                                </div>
                            </details>
                        }
                    </div>
                    }

                    @if (!ShowingAlternates && DisplayedSelections.Count > 80)
                    {
                        <p class="more-results">Showing the first 80 matching recommendations of @DisplayedSelections.Count.ToString("N0").</p>
                    }
                    else if (ShowingAlternates && DisplayedAlternates.Count > 80)
                    {
                        <p class="more-results">Showing the first 80 alternate game files of @DisplayedAlternates.Count.ToString("N0").</p>
                    }
                }
            </section>
        </section>
        }
        else if (_collectionType == "favorites")
        {
            <section class="favorites-builder">
                <div class="favorites-copy">
                    <p class="eyebrow">FAVORITES COLLECTION</p>
                    <h2>Build your personal must-play library</h2>
                    <p>Favorites is where you build a playable collection from games you like. The favorite flag marks games in your catalog; the saved Favorites collection is the build plan you review next.</p>
                    <div class="favorite-count"><span>⭐</span><strong>@_favoriteCount.ToString("N0")</strong><small>favorite releases marked</small></div>
                </div>
                <div class="favorites-form">
                    <label>Collection name<input @bind="_favoritesName" /></label>
                    <label>Destination folder<input @bind="_favoritesDestination" /></label>
                    <button type="button" disabled="@(_selectedFavoriteGameIds.Count == 0 || _isSavingFavorites)" @onclick="SaveFavoritesAsync">@(_isSavingFavorites ? "Saving..." : "Save Favorites Collection")</button>
                    @if (!string.IsNullOrWhiteSpace(_favoritesMessage)) { <p class="save-message">@_favoritesMessage</p> }
                </div>
            </section>

            <section class="favorites-search-panel">
                <div class="preview-heading">
                    <div>
                        <p class="eyebrow">FIND FAVORITE GAMES</p>
                        <h2>Search the selected systems</h2>
                    </div>
                    <span class="preview-count">@_selectedFavoriteGameIds.Count.ToString("N0") selected · @_favoriteResults.Count.ToString("N0") shown</span>
                </div>
                <div class="review-controls">
                    <label class="search-box">
                        Search favorites
                        <input value="@_favoriteSearchText" @oninput="SetFavoriteSearchAsync" placeholder="Mario, filename, system, genre, or series" />
                    </label>
                </div>
                <div class="selection-actions">
                    <button type="button" disabled="@(_favoriteResults.Count == 0)" @onclick="SelectAllMatchingFavorites">Select all matching games</button>
                    <button type="button" disabled="@(_favoriteResults.Count == 0)" @onclick="DeselectAllMatchingFavorites">Deselect all matching games</button>
                    <button type="button" disabled="@(_selectedFavoriteGameIds.Count == 0)" @onclick="AddSelectedFavoritesAsync">Add selected games to Favorites</button>
                    <button type="button" disabled="@(_selectedFavoriteGameIds.Count == 0)" @onclick="RemoveSelectedFavoritesAsync">Remove selected games from Favorites</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_favoritesSearchMessage))
                {
                    <p class="save-message">@_favoritesSearchMessage</p>
                }
                @if (_favoriteResults.Count == 0)
                {
                    <div class="empty-preview">No matching games were found. Try another search or select additional systems.</div>
                }
                else
                {
                    <div class="favorite-results-list">
                        @foreach (var game in _favoriteResults)
                        {
                            <label class="favorite-result-card" @key="game.GameId">
                                <input type="checkbox"
                                       checked="@_selectedFavoriteGameIds.Contains(game.GameId)"
                                       @onchange="args => ToggleFavoriteSelection(game.GameId, args)" />
                                <span>
                                    <strong>@game.Title</strong>
                                    <small>@game.OriginalFilename</small>
                                </span>
                                <span>@game.System</span>
                                <span>@game.Region</span>
                                <span>@game.Language</span>
                                <b class="favorite-flag active-@game.IsFavorite.ToString().ToLowerInvariant()">@(game.IsFavorite ? "Favorite" : "Not favorite")</b>
                            </label>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <section class="collection-placeholder">
                <div class="state-icon" aria-hidden="true">✨</div>
                <p class="eyebrow">COMING NEXT</p>
                <h2>@CurrentCollectionType.Title</h2>
                <p>@CurrentCollectionType.LongDescription</p>
                <span>The shared collection engine is ready for this rule type next.</span>
            </section>
        }

        @if (_inspectedSelection?.AtlasInspection is { } inspection)
        {
            <div class="inspector-backdrop" role="presentation" @onclick="CloseInspector"></div>
            <aside class="atlas-inspector" role="dialog" aria-modal="true" aria-labelledby="atlas-inspector-title">
                <header class="inspector-header">
                    <div>
                        <p class="eyebrow">ATLAS INSPECTOR</p>
                        <h2 id="atlas-inspector-title">@_inspectedSelection.Title</h2>
                    </div>
                    <button type="button" class="inspector-close" aria-label="Close inspector" @onclick="CloseInspector">×</button>
                </header>

                <section class="inspector-summary" aria-label="Atlas decision summary">
                    <article>
                        <span>Winning game file</span>
                        <strong>@inspection.WinningRom</strong>
                    </article>
                    <article>
                        <span>Runner-up</span>
                        <strong>@inspection.RunnerUp</strong>
                    </article>
                    <article>
                        <span>Deciding rule</span>
                        <strong>@inspection.DecidingRule</strong>
                        <small>@inspection.DecidingRuleDescription</small>
                    </article>
                </section>

                <section class="inspector-section">
                    <div class="inspector-section-heading">
                        <h3>Supporting rules</h3>
                        <span>@inspection.SupportingRules.Count</span>
                    </div>
                    @if (inspection.SupportingRules.Count == 0)
                    {
                        <p class="inspector-empty">No later rules also favored the winner.</p>
                    }
                    else
                    {
                        <ul class="supporting-rule-list">
                            @foreach (var rule in inspection.SupportingRules)
                            {
                                <li>@rule</li>
                            }
                        </ul>
                    }
                </section>

                <section class="inspector-section">
                    <div class="inspector-section-heading">
                        <h3>Ordered candidates</h3>
                        <span>@inspection.Candidates.Count</span>
                    </div>
                    <div class="candidate-inspection-list">
                        @foreach (var candidate in inspection.Candidates)
                        {
                            <article class="candidate-inspection-card winner-@candidate.IsWinner.ToString().ToLowerInvariant() runner-@candidate.IsRunnerUp.ToString().ToLowerInvariant()">
                                <header>
                                    <span class="candidate-rank">#@candidate.Order</span>
                                    <strong>@candidate.FileName</strong>
                                    @if (candidate.IsWinner)
                                    {
                                        <b>Winner</b>
                                    }
                                    else if (candidate.IsRunnerUp)
                                    {
                                        <b>Runner-up</b>
                                    }
                                </header>
                                <dl>
                                    <div><dt>Region</dt><dd>@candidate.Region</dd></div>
                                    <div><dt>Language(s)</dt><dd>@string.Join(", ", candidate.Languages)</dd></div>
                                    <div><dt>Dump quality</dt><dd>@candidate.DumpQuality</dd></div>
                                    <div><dt>Revision</dt><dd>@candidate.Revision</dd></div>
                                    <div><dt>Version</dt><dd>@candidate.Version</dd></div>
                                    <div><dt>Release type</dt><dd>@candidate.ReleaseType</dd></div>
                                </dl>
                            </article>
                        }
                    </div>
                </section>
            </aside>
        }

        <footer class="version-label">Atlas Development Preview · v0.0.9</footer>
    }
</main>

@code {
    private const string DumpQualityRuleName = "Dump quality";
    private const string LanguageRuleName = "Language priority";
    private const string RegionRuleName = "Region priority";
    private const string ReleaseTypeRuleName = "Release type";
    private const string RevisionRuleName = "Revision";
    private const string VersionRuleName = "Version";

    private string _collectionType = "1g1r";

    private static readonly CollectionTypeOption[] CollectionTypes =
    [
        new("1g1r", "🏆", "1G1R", "One best release per game", "Choose the best language, region, and revision for every unique game.", true),
        new("favorites", "💜", "Favorites", "A personal must-play library", "Mark favorite games and build a focused collection that is easy to browse.", true),
        new("top", "⭐", "Top Games", "Choose a Top 25, 50, 100, or more", "Create ranked collections by system, genre, rating, or your own preferred number.", false),
        new("genres", "🎭", "Genres", "Action, RPG, puzzle, racing, and more", "Build one or more collections around genres and subgenres.", false),
        new("series", "📚", "Series", "Keep game franchises together", "Group related games such as Mario, Zelda, Final Fantasy, or custom series.", false),
        new("custom", "🧩", "Custom", "Mix rules and hand-picked games", "Combine filters, exclusions, favorites, and manual selections into your own collection.", false)
    ];

    private CollectionTypeOption CurrentCollectionType =>
        CollectionTypes.First(type => type.Id == _collectionType);

    private bool _isLoading = true;
    private ArchiveScanResult? _scan;
    private CollectionRuleOptions _options = new();
    private CollectionRulePreview _preview = new();
    private AtlasProfileStore _profiles = new();
    private AtlasProfile? _activeProfile;
    private string _activeProfileId = string.Empty;
    private string _profileName = string.Empty;
    private string _profileMessage = string.Empty;
    private int _favoriteCount;
    private string _favoritesName = "My Favorites";
    private string _favoritesDestination = string.Empty;
    private string _libraryPath = string.Empty;
    private string _frontend = string.Empty;
    private bool _isSavingFavorites;
    private string _favoritesMessage = string.Empty;
    private string _favoriteSearchText = string.Empty;
    private string _favoritesSearchMessage = string.Empty;
    private IReadOnlyList<FavoriteGameSearchResult> _favoriteResults = [];
    private readonly HashSet<int> _selectedFavoriteGameIds = [];
    private bool _isSavingOneGameOneRom;
    private string _oneGameOneRomMessage = string.Empty;
    private GameSelectionPreview? _inspectedSelection;
    private CollectionReviewState _review = new();
    private CollectionReviewFilters _filters = new();
    private CollectionReviewSummaryFilter _summaryFilter = CollectionReviewSummaryFilter.All;
    private readonly SystemSelectionState _systemSelection = new();
    private string _systemMessage = string.Empty;

    private IReadOnlyList<GameSelectionPreview> DisplayedSelections =>
        _review.Filter(_filters, _summaryFilter);

    private IReadOnlyList<CollectionReviewAlternate> DisplayedAlternates =>
        _review.GetAlternates(_filters);

    private IReadOnlyList<string> AvailableLanguages =>
        _preview.Selections
            .Select(selection => selection.RecommendedLanguage)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<string> AvailableRegions =>
        _preview.Selections
            .Select(selection => selection.RecommendedRegion)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool ShowingAlternates => _summaryFilter == CollectionReviewSummaryFilter.ExtraVersions;

    private IReadOnlyList<CatalogSystemSummary> FilteredCatalogSystems =>
        _systemSelection.FilteredSystems;

    private string SelectedSystemsSummary
    {
        get
        {
            if (_systemSelection.SelectedCount == 0)
            {
                return "No systems selected.";
            }

            if (_systemSelection.SelectedCount == _systemSelection.Systems.Count)
            {
                return "All systems are selected.";
            }

            var selectedNames = _systemSelection.Systems
                .Where(system => _systemSelection.IsSelected(system.SystemKey))
                .OrderBy(system => system.Name, StringComparer.OrdinalIgnoreCase)
                .Take(4)
                .Select(system => system.Name)
                .ToList();

            var remaining = _systemSelection.SelectedCount - selectedNames.Count;
            return remaining > 0
                ? $"{string.Join(", ", selectedNames)} and {remaining:N0} more selected."
                : $"{string.Join(", ", selectedNames)} selected.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _scan = await ScanReportService.LoadLatestAsync();
        var settings = await SettingsService.LoadAsync();
        _libraryPath = settings.LibraryPath ?? string.Empty;
        _favoritesDestination = Path.Combine(settings.LibraryPath ?? string.Empty, "Favorites");
        _frontend = settings.Frontend;
        _favoriteCount = await Collections.GetFavoriteCountAsync();
        _systemSelection.Load(await Collections.GetCatalogSystemsAsync());
        await LoadProfileStateAsync();
        RefreshPreview();
        _isLoading = false;
    }

    private async Task LoadProfileStateAsync()
    {
        _profiles = await AtlasProfiles.LoadAsync();
        _activeProfile = _profiles.ActiveProfile;
        _activeProfileId = _activeProfile.Id;
        _profileName = _activeProfile.Name;
        _options = _activeProfile.ToOptions(_options.Mode);
    }

    private async Task SaveFavoritesAsync()
    {
        _isSavingFavorites = true;
        _favoritesMessage = string.Empty;
        try
        {
            if (!ValidateSystemSelection())
            {
                return;
            }

            var collection = await Collections.SaveFavoritesCollectionAsync(
                _favoritesName,
                _favoritesDestination,
                _frontend,
                _systemSelection.SelectedSystemKeys,
                _selectedFavoriteGameIds);
            _favoritesMessage = $"Saved {collection.Games.Count:N0} games. Opening Build Preview...";
            Navigation.NavigateTo($"/build?collection={collection.Id}");
        }
        catch (Exception ex)
        {
            _favoritesMessage = $"Could not save the collection: {ex.Message}";
        }
        finally
        {
            _isSavingFavorites = false;
        }
    }

    private void RefreshPreview()
    {
        if (_scan is not null)
        {
            _systemMessage = string.Empty;
            if (_systemSelection.SelectedCount == 0)
            {
                _preview = new CollectionRulePreview { EngineName = "Atlas" };
                _review = new CollectionReviewState();
                _systemMessage = "Select at least one system to preview recommendations.";
                return;
            }

            _preview = CollectionRuleService.BuildPreview(BuildScopedScan(_scan), _options);
            _review = new CollectionReviewState();
            _review.LoadRecommendations(_preview.Selections);
            _inspectedSelection = null;
            _summaryFilter = CollectionReviewSummaryFilter.All;
            _filters = new CollectionReviewFilters();
        }
    }

    private async Task SaveOneGameOneRomAsync()
    {
        _isSavingOneGameOneRom = true;
        _oneGameOneRomMessage = string.Empty;

        try
        {
            var selected = _review.GetSelectedSelectionKeys();
            if (!ValidateSystemSelection())
            {
                return;
            }

            if (selected.Count == 0)
            {
                _oneGameOneRomMessage = "Select at least one game before opening Build Preview.";
                return;
            }

            var name = _options.Mode == OneGameOneRomMode.EnglishOnly
                ? "1G1R - English Only"
                : "1G1R - All Games";
            var destination = Path.Combine(_libraryPath, name);
            var collection = await Collections.SaveOneGameOneRomCollectionAsync(
                name,
                destination,
                _frontend,
                selected,
                _systemSelection.SelectedSystemKeys);

            _oneGameOneRomMessage = $"Saved {collection.Games.Count:N0} selected games. Opening Build Preview...";
            Navigation.NavigateTo($"/build?collection={collection.Id}");
        }
        catch (Exception ex)
        {
            _oneGameOneRomMessage = $"Could not save the collection: {ex.Message}";
        }
        finally
        {
            _isSavingOneGameOneRom = false;
        }
    }

    private void ToggleSelection(GameSelectionPreview selection, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        _review.SetSelected(selection, selected);
    }

    private void SelectDisplayedRecommendations() => _review.SelectAll(DisplayedSelections.ToList());

    private void SelectNoDisplayedRecommendations() => _review.SelectNone(DisplayedSelections.ToList());

    private void InvertDisplayedRecommendations() => _review.InvertSelection(DisplayedSelections.ToList());

    private void ResetRecommendations() => _review.ResetToAtlasRecommendations();

    private async Task SetCollectionTypeAsync(string typeId)
    {
        _collectionType = typeId;
        if (_collectionType == "favorites")
        {
            await RefreshFavoriteResultsAsync();
        }
    }

    private void SelectAllSystemKeys()
    {
        _systemSelection.SelectAll();
    }

    private async Task SelectAllSystemsAsync()
    {
        SelectAllSystemKeys();
        await RefreshAfterSystemSelectionAsync();
    }

    private async Task SelectNoSystemsAsync()
    {
        _systemSelection.SelectNone();
        await RefreshAfterSystemSelectionAsync();
    }

    private async Task SelectMatchingSystemsAsync()
    {
        _systemSelection.SelectMatching();

        await RefreshAfterSystemSelectionAsync();
    }

    private async Task ToggleSystemAsync(string systemKey, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            _systemSelection.Toggle(systemKey, true);
        }
        else
        {
            _systemSelection.Toggle(systemKey, false);
            _selectedFavoriteGameIds.RemoveWhere(gameId =>
                _favoriteResults.Any(game => game.GameId == gameId && game.SystemKey.Equals(systemKey, StringComparison.OrdinalIgnoreCase)));
        }

        await RefreshAfterSystemSelectionAsync();
    }

    private async Task RefreshAfterSystemSelectionAsync()
    {
        RefreshPreview();
        if (_collectionType == "favorites")
        {
            await RefreshFavoriteResultsAsync();
        }
    }

    private bool ValidateSystemSelection()
    {
        if (_systemSelection.SelectedCount > 0)
        {
            _systemMessage = string.Empty;
            return true;
        }

        _systemMessage = "Select at least one system before saving or reviewing a collection.";
        return false;
    }

    private ArchiveScanResult BuildScopedScan(ArchiveScanResult scan)
    {
        bool Include(DuplicateGroupSummary group) =>
            string.IsNullOrWhiteSpace(group.SystemKey) ||
            _systemSelection.IsSelected(SystemIdentity.CanonicalKey(group.SystemKey));

        return new ArchiveScanResult
        {
            ArchivePath = scan.ArchivePath,
            StartedAt = scan.StartedAt,
            CompletedAt = scan.CompletedAt,
            RecognizedFileCount = scan.OneGameOneRomGroups.Where(Include).Sum(group => group.FileCount),
            IgnoredFileCount = scan.IgnoredFileCount,
            Systems = scan.Systems
                .Where(system => _systemSelection.IsSelected(SystemIdentity.CanonicalKey(system.Name)))
                .ToList(),
            FileTypes = scan.FileTypes,
            Regions = scan.Regions,
            Languages = scan.Languages,
            SpecialTags = scan.SpecialTags,
            OneGameOneRomGroups = scan.OneGameOneRomGroups.Where(Include).ToList(),
            DuplicateGroups = scan.DuplicateGroups.Where(Include).ToList(),
            MultiDiscGroups = scan.MultiDiscGroups,
            Warnings = scan.Warnings
        };
    }

    private async Task SetFavoriteSearchAsync(ChangeEventArgs args)
    {
        _favoriteSearchText = args.Value?.ToString() ?? string.Empty;
        await RefreshFavoriteResultsAsync();
    }

    private async Task RefreshFavoriteResultsAsync()
    {
        _favoritesSearchMessage = string.Empty;
        _favoriteResults = await Collections.SearchFavoriteGamesAsync(_favoriteSearchText, _systemSelection.SelectedSystemKeys);
    }

    private void ToggleFavoriteSelection(int gameId, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            _selectedFavoriteGameIds.Add(gameId);
        }
        else
        {
            _selectedFavoriteGameIds.Remove(gameId);
        }
    }

    private void SelectAllMatchingFavorites()
    {
        foreach (var game in _favoriteResults)
        {
            _selectedFavoriteGameIds.Add(game.GameId);
        }
    }

    private void DeselectAllMatchingFavorites()
    {
        foreach (var game in _favoriteResults)
        {
            _selectedFavoriteGameIds.Remove(game.GameId);
        }
    }

    private async Task AddSelectedFavoritesAsync()
    {
        var changed = await Collections.SetFavoritesAsync(_selectedFavoriteGameIds, true);
        _favoriteCount = await Collections.GetFavoriteCountAsync();
        await RefreshFavoriteResultsAsync();
        _favoritesSearchMessage = $"Marked {changed:N0} selected games as favorites.";
    }

    private async Task RemoveSelectedFavoritesAsync()
    {
        var changed = await Collections.SetFavoritesAsync(_selectedFavoriteGameIds, false);
        _favoriteCount = await Collections.GetFavoriteCountAsync();
        await RefreshFavoriteResultsAsync();
        _favoritesSearchMessage = $"Removed favorite flags from {changed:N0} selected games.";
    }

    private static string AlternateKey(CollectionReviewAlternate alternate) =>
        $"{alternate.Selection.SelectionKey}|{alternate.AlternateFilename}";

    private static string SystemMediaIcon(CatalogSystemSummary system) =>
        SystemIdentity.ResolveMediaType(system.Name, system.SystemKey) switch
        {
            "Arcade board" => "▦",
            "Optical disc" => "◉",
            "Floppy disk" => "▣",
            "Cassette" => "▭",
            _ => "▤"
        };

    private void ToggleSummaryFilter(CollectionReviewSummaryFilter filter)
    {
        _summaryFilter = _summaryFilter == filter
            ? CollectionReviewSummaryFilter.All
            : filter;
    }

    private string SummaryFilterClass(CollectionReviewSummaryFilter filter) =>
        _summaryFilter == filter ? "active" : string.Empty;

    private void InspectSelection(GameSelectionPreview selection)
    {
        _inspectedSelection = selection.AtlasInspection is null ? null : selection;
    }

    private void CloseInspector()
    {
        _inspectedSelection = null;
    }

    private void SetMode(OneGameOneRomMode mode)
    {
        _options.Mode = mode;
        RefreshPreview();
    }

    private async Task ChangeActiveProfileAsync(ChangeEventArgs args)
    {
        var profileId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(profileId))
        {
            return;
        }

        var mode = _options.Mode;
        _activeProfile = await AtlasProfiles.SetActiveProfileAsync(profileId);
        _profiles = await AtlasProfiles.LoadAsync();
        _activeProfileId = _activeProfile.Id;
        _profileName = _activeProfile.Name;
        _options = _activeProfile.ToOptions(mode);
        _profileMessage = $"Using {_activeProfile.Name}.";
        RefreshPreview();
    }

    private async Task CreateProfileAsync()
    {
        var profile = await AtlasProfiles.CreateProfileAsync(NextProfileName("Personal"));
        await ActivateProfileAsync(profile, $"Created {profile.Name}.");
    }

    private async Task DuplicateProfileAsync()
    {
        if (_activeProfile is null)
        {
            return;
        }

        var profile = await AtlasProfiles.DuplicateProfileAsync(_activeProfile.Id, NextProfileName($"{_activeProfile.Name} Copy"));
        await ActivateProfileAsync(profile, $"Duplicated {profile.Name}.");
    }

    private async Task SaveActiveProfileAsync()
    {
        if (_activeProfile is null)
        {
            return;
        }

        _activeProfile.Name = NormalizeProfileName(_profileName);
        _activeProfile.ApplyOptions(_options);
        var profile = await AtlasProfiles.SaveProfileAsync(_activeProfile);
        await ActivateProfileAsync(profile, $"Saved {profile.Name}.");
    }

    private async Task RenameProfileAsync()
    {
        if (_activeProfile is null)
        {
            return;
        }

        var profile = await AtlasProfiles.RenameProfileAsync(_activeProfile.Id, NormalizeProfileName(_profileName));
        await ActivateProfileAsync(profile, $"Renamed {profile.Name}.");
    }

    private async Task DeleteActiveProfileAsync()
    {
        if (_activeProfile is null)
        {
            return;
        }

        var deletedName = _activeProfile.Name;
        await AtlasProfiles.DeleteProfileAsync(_activeProfile.Id);
        await LoadProfileStateAsync();
        _profileMessage = $"Deleted {deletedName}.";
        RefreshPreview();
    }

    private async Task ActivateProfileAsync(AtlasProfile profile, string message)
    {
        await AtlasProfiles.SetActiveProfileAsync(profile.Id);
        await LoadProfileStateAsync();
        _profileMessage = message;
        RefreshPreview();
    }

    private void MoveLanguage(string language, int direction) => MoveItem(_options.LanguagePriority, language, direction);
    private void MoveRegion(string region, int direction) => MoveItem(_options.RegionPriority, region, direction);

    private void MoveItem(List<string> items, string item, int direction)
    {
        var source = items.FindIndex(value => value.Equals(item, StringComparison.OrdinalIgnoreCase));
        if (source < 0) return;

        var destination = source + direction;
        if (destination < 0 || destination >= items.Count) return;

        var reordered = items.ToList();
        reordered.RemoveAt(source);
        reordered.Insert(destination, item);

        if (ReferenceEquals(items, _options.LanguagePriority)) _options.LanguagePriority = reordered;
        else _options.RegionPriority = reordered;

        RefreshPreview();
    }

    private bool IsRuleEnabled(string ruleName) =>
        _options.EnabledRuleNames.Contains(ruleName);

    private void SetRuleEnabled(string ruleName, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        if (enabled)
        {
            _options.EnabledRuleNames.Add(ruleName);
        }
        else
        {
            _options.EnabledRuleNames.Remove(ruleName);
        }

        RefreshPreview();
    }

    private void SetReleaseRule(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _options.AvoidSpecialReleases = enabled;
        if (enabled) _options.EnabledRuleNames.Add(ReleaseTypeRuleName);
        else _options.EnabledRuleNames.Remove(ReleaseTypeRuleName);
        RefreshPreview();
    }

    private void SetRevisionRule(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _options.PreferNewestRevision = enabled;
        if (enabled) _options.EnabledRuleNames.Add(RevisionRuleName);
        else _options.EnabledRuleNames.Remove(RevisionRuleName);
        RefreshPreview();
    }

    private void SetVersionRule(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _options.PreferNewestVersion = enabled;
        if (enabled) _options.EnabledRuleNames.Add(VersionRuleName);
        else _options.EnabledRuleNames.Remove(VersionRuleName);
        RefreshPreview();
    }

    private void UseEnglishPreset()
    {
        _options.LanguagePriority = ["English", "Japanese", "French", "German", "Spanish", "Italian", "Portuguese", "Korean", "Dutch", "Swedish", "Unknown"];
        _options.RegionPriority = ["USA", "World", "Europe", "Australia", "United Kingdom", "Canada", "Japan", "Korea", "Brazil", "France", "Germany", "Spain", "Italy", "Unknown"];
        RefreshPreview();
    }

    private void UseJapanesePreset()
    {
        _options.LanguagePriority = ["Japanese", "English", "Korean", "French", "German", "Spanish", "Italian", "Portuguese", "Dutch", "Swedish", "Unknown"];
        _options.RegionPriority = ["Japan", "World", "USA", "Europe", "Korea", "Australia", "United Kingdom", "Canada", "Brazil", "France", "Germany", "Spain", "Italy", "Unknown"];
        RefreshPreview();
    }

    private void UseEuropeanPreset()
    {
        _options.LanguagePriority = ["English", "French", "German", "Spanish", "Italian", "Portuguese", "Dutch", "Swedish", "Japanese", "Korean", "Unknown"];
        _options.RegionPriority = ["Europe", "United Kingdom", "World", "Australia", "USA", "Canada", "France", "Germany", "Spain", "Italy", "Japan", "Korea", "Brazil", "Unknown"];
        RefreshPreview();
    }

    private string NextProfileName(string baseName)
    {
        var existingNames = _profiles.Profiles
            .Select(profile => profile.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!existingNames.Contains(baseName))
        {
            return baseName;
        }

        for (var index = 2; ; index++)
        {
            var candidate = $"{baseName} {index}";
            if (!existingNames.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    private static string NormalizeProfileName(string value) =>
        string.IsNullOrWhiteSpace(value) ? "Personal" : value.Trim();

    private sealed record CollectionTypeOption(string Id, string Icon, string Title, string Description, string LongDescription, bool Available);
}

        RefreshPreview();
    }

    private void MoveLanguage(string language, int direction) => MoveItem(_options.LanguagePriority, language, direction);
    private void MoveRegion(string region, int direction) => MoveItem(_options.RegionPriority, region, direction);

    private void MoveItem(List<string> items, string item, int direction)
    {
        var source = items.FindIndex(value => value.Equals(item, StringComparison.OrdinalIgnoreCase));
        if (source < 0) return;

        var destination = source + direction;
        if (destination < 0 || destination >= items.Count) return;

        var reordered = items.ToList();
        reordered.RemoveAt(source);
        reordered.Insert(destination, item);

        if (ReferenceEquals(items, _options.LanguagePriority)) _options.LanguagePriority = reordered;
        else _options.RegionPriority = reordered;

        RefreshPreview();
    }


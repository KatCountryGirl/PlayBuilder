    private async Task ToggleSystemAsync(string systemKey, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            _systemSelection.Toggle(systemKey, true);
        }
        else
        {
            _systemSelection.Toggle(systemKey, false);
            _selectedFavoriteGameIds.RemoveWhere(gameId =>
                _favoriteResults.Any(game => game.GameId == gameId && game.SystemKey.Equals(systemKey, StringComparison.OrdinalIgnoreCase)));
        }

        await RefreshAfterSystemSelectionAsync();
    }

    private async Task RefreshAfterSystemSelectionAsync()
    {
        RefreshPreview();
        if (_workflow == CollectionWorkflow.Favorites)
        {
            await RefreshFavoriteResultsAsync();
        }
    }

    private bool ValidateSystemSelection()
    {
        if (_systemSelection.SelectedCount > 0)
        {
            _systemMessage = string.Empty;
            return true;
        }

        _systemMessage = "Select at least one system before saving or reviewing a collection.";
        return false;
    }

    private ArchiveScanResult BuildScopedScan(ArchiveScanResult scan)
    {
        bool Include(DuplicateGroupSummary group) =>
            string.IsNullOrWhiteSpace(group.SystemKey) ||
            _systemSelection.IsSelected(SystemIdentity.CanonicalKey(group.SystemKey));

        return new ArchiveScanResult
        {
            ArchivePath = scan.ArchivePath,
            StartedAt = scan.StartedAt,
            CompletedAt = scan.CompletedAt,
            RecognizedFileCount = scan.OneGameOneRomGroups.Where(Include).Sum(group => group.FileCount),
            IgnoredFileCount = scan.IgnoredFileCount,
            Systems = scan.Systems
                .Where(system => _systemSelection.IsSelected(SystemIdentity.CanonicalKey(system.Name)))
                .ToList(),
            FileTypes = scan.FileTypes,
            Regions = scan.Regions,
            Languages = scan.Languages,
            SpecialTags = scan.SpecialTags,
            OneGameOneRomGroups = scan.OneGameOneRomGroups.Where(Include).ToList(),
            DuplicateGroups = scan.DuplicateGroups.Where(Include).ToList(),
            MultiDiscGroups = scan.MultiDiscGroups,
            Warnings = scan.Warnings
        };
    }


@page "/scan"
@implements IDisposable
@inject ISettingsService SettingsService
@inject IGameScanWorkflowService GameScanWorkflow
@inject IScanReportService ScanReportService
@inject NavigationManager Navigation

<PageTitle>Scan Games · PlayBuilder</PageTitle>

<main class="scan-page">
    @if (_isLoading)
    {
        <section class="scan-state">Loading scan settings...</section>
    }
    else
    {
        <section class="scan-hero">
            <div>
                <p class="eyebrow">SCAN GAMES</p>
                <h1>Find your ROMs and get ready to build.</h1>
                <p>Choose your folders, scan your source ROM folder, then review the games PlayBuilder found. Scanning is read-only.</p>
            </div>
            <a class="builder-link" href="/collection-rules">Choose Collection Type</a>
        </section>

        <section class="scan-layout">
            <article class="scan-card setup-card">
                <header>
                    <p class="eyebrow">FOLDERS</p>
                    <h2>Scan setup</h2>
                    <p>PlayBuilder reads from your source folder and saves curated collections to a separate destination.</p>
                </header>

                <label>
                    Source ROM folder
                    <input value="@_archivePath" @oninput="args => _archivePath = args.Value?.ToString() ?? string.Empty" />
                </label>

                <label>
                    Destination folder
                    <input value="@_libraryPath" @oninput="args => _libraryPath = args.Value?.ToString() ?? string.Empty" />
                </label>

                <label>
                    Frontend
                    <select value="@_frontend" @onchange="args => _frontend = args.Value?.ToString() ?? Frontends[0]">
                        @foreach (var frontend in Frontends)
                        {
                            <option value="@frontend">@frontend</option>
                        }
                    </select>
                </label>

                <div class="scan-actions">
                    @if (_isScanning)
                    {
                        <button type="button" class="secondary" @onclick="CancelScan">Cancel Scan</button>
                    }
                    else
                    {
                        <button type="button" @onclick="StartScanAsync">
                            @(_latestScan is null ? "Scan Games" : "Rescan")
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="scan-message @(_messageIsError ? "error" : "success")">@_message</p>
                }
            </article>

            <article class="scan-card progress-card">
                <header>
                    <p class="eyebrow">PROGRESS</p>
                    <h2>@(_isScanning ? "Scanning..." : "Ready")</h2>
                    <p>@(_isScanning ? "PlayBuilder is reading filenames and grouping releases." : "Start a scan whenever your source ROM folder changes.")</p>
                </header>

                @if (_isScanning)
                {
                    <div class="scan-progress" role="status" aria-live="polite">
                        <strong>@_progress.RecognizedFiles.ToString("N0") ROMs found</strong>
                        <span>@_progress.FilesChecked.ToString("N0") files checked</span>
                        <span>@_progress.Phase</span>
                        @if (!string.IsNullOrWhiteSpace(_progress.CurrentFile))
                        {
                            <small>@_progress.CurrentFile</small>
                        }
                        <small>@ShortenPath(_progress.CurrentFolder)</small>
                    </div>
                }
                else if (_latestScan is null)
                {
                    <div class="scan-empty">No completed scan yet.</div>
                }
                else
                {
                    <div class="summary-grid">
                        <article><span>ROMs found</span><strong>@_latestScan.RecognizedFileCount.ToString("N0")</strong></article>
                        <article><span>1G1R groups</span><strong>@_latestScan.OneGameOneRomGroups.Count.ToString("N0")</strong></article>
                        <article><span>Single-ROM groups</span><strong>@_latestScan.OneGameOneRomGroups.Count(group => group.FileCount == 1).ToString("N0")</strong></article>
                        <article><span>Multi-ROM groups</span><strong>@_latestScan.OneGameOneRomGroups.Count(group => group.FileCount > 1).ToString("N0")</strong></article>
                        <article><span>Duplicate groups</span><strong>@_latestScan.DuplicateGroups.Count.ToString("N0")</strong></article>
                        <article><span>Warnings</span><strong>@_latestScan.Warnings.Count.ToString("N0")</strong></article>
                    </div>

                    <p class="completed-copy">
                        Completed @FormatLocalTime(_latestScan.CompletedAt). Your next step is choosing a collection type.
                    </p>
                }
            </article>
        </section>
    }
</main>

@code {
    private static readonly string[] Frontends = ["RetroBat", "ES-DE", "EmulationStation", "LaunchBox", "Batocera", "Other"];

    private bool _isLoading = true;
    private bool _isScanning;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _archivePath = string.Empty;
    private string _libraryPath = string.Empty;
    private string _frontend = Frontends[0];
    private DateTimeOffset? _setupCompletedAt;
    private ArchiveScanResult? _latestScan;
    private CancellationTokenSource? _scanCancellation;
    private ArchiveScanProgress _progress = new(0, 0, string.Empty, string.Empty, TimeSpan.Zero);

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.LoadAsync();
        _archivePath = settings.ArchivePath;
        _libraryPath = settings.LibraryPath;
        _frontend = string.IsNullOrWhiteSpace(settings.Frontend) ? Frontends[0] : settings.Frontend;
        _setupCompletedAt = settings.SetupCompletedAt;
        _latestScan = await ScanReportService.LoadLatestAsync();
        _isLoading = false;
    }

    private async Task StartScanAsync()
    {
        _message = string.Empty;
        _messageIsError = false;

        if (string.IsNullOrWhiteSpace(_archivePath) ||
            string.IsNullOrWhiteSpace(_libraryPath) ||
            string.IsNullOrWhiteSpace(_frontend))
        {
            _message = "Choose a source ROM folder, destination folder, and frontend before scanning.";
            _messageIsError = true;
            return;
        }

        _isScanning = true;
        _progress = new ArchiveScanProgress(0, 0, _archivePath, string.Empty, TimeSpan.Zero);
        _scanCancellation = new CancellationTokenSource();

        var settings = new PlayBuilderSettings
        {
            ArchivePath = _archivePath.Trim(),
            LibraryPath = _libraryPath.Trim(),
            Frontend = _frontend,
            ProtectArchive = true,
            SetupCompletedAt = _setupCompletedAt ?? DateTimeOffset.UtcNow
        };

        var progress = new Progress<ArchiveScanProgress>(value =>
        {
            _progress = value;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            await SettingsService.SaveAsync(settings);
            _latestScan = await GameScanWorkflow.ScanAndSaveAsync(settings, progress, _scanCancellation.Token);
            _message = "Scan complete. You can choose a collection type next.";
            _setupCompletedAt ??= settings.SetupCompletedAt;
        }
        catch (OperationCanceledException)
        {
            _message = "Scan cancelled. No game files were changed.";
        }
        catch (DirectoryNotFoundException)
        {
            _message = "The source ROM folder could not be found.";
            _messageIsError = true;
        }
        catch (UnauthorizedAccessException)
        {
            _message = "PlayBuilder does not have permission to read the source ROM folder.";
            _messageIsError = true;
        }
        catch (Exception)
        {
            _message = "The scan could not finish. Your game files were not changed.";
            _messageIsError = true;
        }
        finally
        {
            _isScanning = false;
            _scanCancellation?.Dispose();
            _scanCancellation = null;
        }
    }

    private void CancelScan()
    {
        _scanCancellation?.Cancel();
    }

    private static string FormatLocalTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt");

    private static string ShortenPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "Preparing scan...";
        }

        return path.Length <= 90 ? path : $"...{path[^87..]}";
    }

    public void Dispose()
    {
        _scanCancellation?.Cancel();
        _scanCancellation?.Dispose();
    }
}

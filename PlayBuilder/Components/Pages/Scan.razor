@page "/scan"
@implements IDisposable
@inject ISettingsService SettingsService
@inject IGameScanSessionService ScanSession
@inject IScanReportService ScanReportService
@inject IFolderPickerService FolderPicker
@inject NavigationManager Navigation

<PageTitle>Scan Games · PlayBuilder</PageTitle>

<main class="scan-page">
    @if (_isLoading)
    {
        <section class="scan-state">Loading scan settings...</section>
    }
    else
    {
        <section class="scan-hero">
            <div>
                <p class="eyebrow">SCAN GAMES</p>
                <h1>Find your games and get ready to build.</h1>
                <p>Choose your folders, scan your source Game folder, then review the games PlayBuilder found. Scanning is read-only and continues in the background.</p>
            </div>
            <a class="builder-link" href="/collection-rules">Choose Collection Type</a>
        </section>

        <section class="scan-layout">
            <article class="scan-card setup-card">
                <header>
                    <p class="eyebrow">FOLDERS</p>
                    <h2>Scan setup</h2>
                    <p>PlayBuilder reads from your source folder and saves curated collections to a separate destination.</p>
                </header>

                <label>
                    Source Game folder
                    <span class="path-input-row">
                        <input value="@_archivePath" @oninput="args => _archivePath = args.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="browse-button" @onclick="BrowseSourceFolderAsync">Browse</button>
                    </span>
                </label>

                <label>
                    Destination folder
                    <span class="path-input-row">
                        <input value="@_libraryPath" @oninput="args => _libraryPath = args.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="browse-button" @onclick="BrowseDestinationFolderAsync">Browse</button>
                    </span>
                </label>

                <label>
                    Frontend
                    <select value="@_frontend" @onchange="args => _frontend = args.Value?.ToString() ?? Frontends[0]">
                        @foreach (var frontend in Frontends)
                        {
                            <option value="@frontend">@frontend</option>
                        }
                    </select>
                    <small class="field-help">Frontend controls the destination folder layout for the finished collection. Your original game files are not changed.</small>
                </label>

                <div class="scan-actions">
                    @if (_snapshot.IsRunning)
                    {
                        <button type="button" class="secondary" @onclick="ScanSession.CancelScan">Cancel Scan</button>
                    }
                    else
                    {
                        <button type="button" @onclick="StartScanAsync">
                            @(_snapshot.LastCompletedScan is null ? "Scan Games" : "Rescan")
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_snapshot.Message))
                {
                    <p class="scan-message @(_snapshot.MessageIsError ? "error" : "success")">@_snapshot.Message</p>
                }
            </article>

            <article class="scan-card progress-card">
                <header>
                    <p class="eyebrow">PROGRESS</p>
                    <h2>@GetStatusHeading()</h2>
                    <p>@(_snapshot.IsRunning ? "PlayBuilder is reading filenames and grouping game releases. You can leave this page and come back later." : "Start a scan whenever your source Game folder changes.")</p>
                </header>

                @if (_snapshot.IsRunning)
                {
                    <div class="scan-progress" role="status" aria-live="polite">
                        <strong>@_snapshot.Progress.RecognizedFiles.ToString("N0") games found</strong>
                        <span>@_snapshot.Progress.FilesChecked.ToString("N0") files checked</span>
                        <span>@_snapshot.Progress.Phase</span>
                        @if (!string.IsNullOrWhiteSpace(_snapshot.Progress.CurrentFile))
                        {
                            <small>@_snapshot.Progress.CurrentFile</small>
                        }
                        <small>@ShortenPath(_snapshot.Progress.CurrentFolder)</small>
                    </div>
                }
                else if (_snapshot.LastCompletedScan is null)
                {
                    <div class="scan-empty">No completed scan yet.</div>
                }
                else
                {
                    <div class="summary-grid">
                        <article><span>Games found</span><strong>@_snapshot.LastCompletedScan.RecognizedFileCount.ToString("N0")</strong></article>
                        <article><span>1G1R groups</span><strong>@_snapshot.LastCompletedScan.OneGameOneRomGroups.Count.ToString("N0")</strong></article>
                        <article><span>Single-game groups</span><strong>@_snapshot.LastCompletedScan.OneGameOneRomGroups.Count(group => group.FileCount == 1).ToString("N0")</strong></article>
                        <article><span>Multi-game groups</span><strong>@_snapshot.LastCompletedScan.OneGameOneRomGroups.Count(group => group.FileCount > 1).ToString("N0")</strong></article>
                        <article><span>Duplicate groups</span><strong>@_snapshot.LastCompletedScan.DuplicateGroups.Count.ToString("N0")</strong></article>
                        <article><span>Warnings</span><strong>@_snapshot.LastCompletedScan.Warnings.Count.ToString("N0")</strong></article>
                    </div>

                    <p class="completed-copy">
                        Completed @FormatLocalTime(_snapshot.LastCompletedScan.CompletedAt). Your next step is choosing a collection type.
                    </p>
                }
            </article>
        </section>
    }
</main>

@code {
    private static readonly string[] Frontends = ["RetroBat", "ES-DE", "EmulationStation", "LaunchBox", "Batocera", "Generic Folder"];

    private bool _isLoading = true;
    private string _archivePath = string.Empty;
    private string _libraryPath = string.Empty;
    private string _frontend = Frontends[0];
    private DateTimeOffset? _setupCompletedAt;
    private GameScanSessionSnapshot _snapshot = GameScanSessionSnapshot.Idle();

    protected override async Task OnInitializedAsync()
    {
        ScanSession.SnapshotChanged += HandleScanSnapshotChanged;
        var settings = await SettingsService.LoadAsync();
        _archivePath = settings.ArchivePath;
        _libraryPath = settings.LibraryPath;
        _frontend = string.IsNullOrWhiteSpace(settings.Frontend) ? Frontends[0] : settings.Frontend;
        _setupCompletedAt = settings.SetupCompletedAt;
        var latestScan = await ScanReportService.LoadLatestAsync();
        _snapshot = ScanSession.Snapshot.LastCompletedScan is null && latestScan is not null
            ? GameScanSessionSnapshot.Idle(latestScan)
            : ScanSession.Snapshot;
        _isLoading = false;
    }

    private async Task StartScanAsync()
    {
        if (string.IsNullOrWhiteSpace(_archivePath) ||
            string.IsNullOrWhiteSpace(_libraryPath) ||
            string.IsNullOrWhiteSpace(_frontend))
        {
            _snapshot = _snapshot with
            {
                Message = "Choose a source Game folder, destination folder, and frontend before scanning.",
                MessageIsError = true
            };
            return;
        }

        var settings = new PlayBuilderSettings
        {
            ArchivePath = _archivePath.Trim(),
            LibraryPath = _libraryPath.Trim(),
            Frontend = _frontend,
            ProtectArchive = true,
            SetupCompletedAt = _setupCompletedAt ?? DateTimeOffset.UtcNow
        };

        await SettingsService.SaveAsync(settings);

        if (!await ScanSession.StartScanAsync(settings))
        {
            _snapshot = ScanSession.Snapshot with
            {
                Message = "A scan is already running. Return to this page to watch progress or cancel it.",
                MessageIsError = true
            };
        }

        _setupCompletedAt ??= settings.SetupCompletedAt;
    }

    private async Task BrowseSourceFolderAsync()
    {
        var selected = await FolderPicker.PickFolderAsync("Choose the source Game folder", _archivePath);
        if (!string.IsNullOrWhiteSpace(selected))
        {
            _archivePath = selected;
        }
    }

    private async Task BrowseDestinationFolderAsync()
    {
        var selected = await FolderPicker.PickFolderAsync("Choose the destination folder", _libraryPath);
        if (!string.IsNullOrWhiteSpace(selected))
        {
            _libraryPath = selected;
        }
    }

    private string GetStatusHeading() => _snapshot.Status switch
    {
        GameScanStatus.Running => "Scanning...",
        GameScanStatus.Completed => "Scan complete",
        GameScanStatus.Cancelled => "Scan cancelled",
        GameScanStatus.Failed => "Scan needs attention",
        _ => "Ready"
    };

    private static string FormatLocalTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt");

    private static string ShortenPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "Preparing scan...";
        }

        return path.Length <= 90 ? path : $"...{path[^87..]}";
    }

    public void Dispose()
    {
        ScanSession.SnapshotChanged -= HandleScanSnapshotChanged;
    }

    private void HandleScanSnapshotChanged()
    {
        _snapshot = ScanSession.Snapshot;
        _ = InvokeAsync(StateHasChanged);
    }
}
